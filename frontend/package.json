{
  "name": "kb-freshness-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "perf:bundle": "node ../scripts/perf/bundle-report.mjs",
    "perf:build": "node ../scripts/perf/measure-build-time.mjs",
    "perf:assets": "bash ../scripts/perf/check-assets.sh",
    "perf:memory": "node --expose-gc ../scripts/perf/memory-smoke.mjs",
    "perf:summary": "node ../scripts/perf/summarize.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
